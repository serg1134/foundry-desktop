FOUNDRY_GATEWAY_HOST=0.0.0.0
FOUNDRY_GATEWAY_PORT=8787
FOUNDRY_GATEWAY_DATABASE=/var/lib/foundry/gateway.sqlite
# PostgreSQL deployments verify the server certificate by default. Set SSL=0 only
# for a trusted local database, or TLS_INSECURE=1 only as a temporary diagnostic.
FOUNDRY_DATABASE_SSL=1
FOUNDRY_DATABASE_TLS_INSECURE=0
FOUNDRY_SIGNUP_CREDITS=25000
FOUNDRY_TRUST_PROXY=1
FOUNDRY_LOG_SALT=REPLACE_WITH_RANDOM_SECRET
FOUNDRY_BILLING_SUCCESS_URL=https://YOUR_DOMAIN/billing/success
FOUNDRY_BILLING_CANCEL_URL=https://YOUR_DOMAIN/billing/cancel
# Set this explicitly for every deployment. Never put live Stripe keys in a test environment.
FOUNDRY_STRIPE_MODE=test
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_BUILDER=
STRIPE_PRICE_STUDIO=
