{
  "name": "foundry-desktop",
  "version": "0.7.0",
  "description": "A Windows-first AI desktop application builder.",
  "author": "Foundry",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-transform-types --test tests/*.test.ts",
    "release:audit": "node scripts/generate-release-audit.mjs",
    "gateway:dev": "node --experimental-transform-types src/main/gateway/server.ts",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "dist:mac": "npm run build && electron-builder --mac dmg --x64 --arm64",
    "dist:linux": "npm run build && electron-builder --linux AppImage --x64",
    "release:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-release.ps1"
  },
  "dependencies": {
    "@electron-toolkit/utils": "4.0.0",
    "electron-updater": "6.8.9",
    "esbuild": "0.25.12",
    "isomorphic-git": "1.40.0",
    "pg": "8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.2.0",
    "electron-vite": "5.0.0",
    "typescript": "7.0.2",
    "vite": "7.3.6"
  },
  "optionalDependencies": {
    "electron-builder": "26.15.3"
  },
  "allowScripts": {
    "electron@43.2.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true
  },
  "build": {
    "appId": "com.foundry.desktop",
    "productName": "Foundry",
    "asar": true,
    "asarUnpack": [
      "node_modules/esbuild/**",
      "node_modules/@esbuild/**",
      "node_modules/app-builder-bin/**",
      "node_modules/app-builder-lib/**",
      "node_modules/electron-builder/**"
    ],
    "files": [
      "out/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "app-icon.png"
      }
    ],
    "directories": {
      "output": "release"
    },
    "artifactName": "Foundry-Setup-${version}.${ext}",
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "category": "Development",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
