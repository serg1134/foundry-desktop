FROM node:24-bookworm-slim
ENV NODE_ENV=production FOUNDRY_GATEWAY_HOST=0.0.0.0 FOUNDRY_GATEWAY_PORT=8787 FOUNDRY_GATEWAY_DATABASE=/var/lib/foundry/gateway.sqlite
WORKDIR /app
COPY src/main/providers.ts ./src/main/providers.ts
COPY src/main/gateway ./src/main/gateway
RUN mkdir -p /var/lib/foundry && chown -R node:node /app /var/lib/foundry
USER node
EXPOSE 8787
VOLUME ["/var/lib/foundry"]
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 CMD ["node","-e","fetch('http://127.0.0.1:8787/health/ready').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]
CMD ["node","--experimental-transform-types","src/main/gateway/server.ts"]
